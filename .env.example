# Public vars must start with NEXT_PUBLIC_
NEXT_PUBLIC_APP_NAME=puddings-world

# Server-only secrets (do NOT prefix with NEXT_PUBLIC_)
# DATABASE_URL=

# Contact form email (optional; messages are always stored in Redis)
# RESEND_API_KEY=
# CONTACT_TO=geniuspuddingforgames@gmail.com
# CONTACT_FROM=puddingsworld <onboarding@resend.dev>

# Password for the hidden /admin dashboard; unset disables login
# ADMIN_PASSWORD=

# Key for hashing visitor IPs (stats, rate limits, KTV quotas); any long
# random string. Unset falls back to a plain SHA-256, which can be reversed.
# IP_HASH_SALT=
